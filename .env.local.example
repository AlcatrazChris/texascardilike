# 复制为 .env.local 后填写。本地启动会自动加载，禁止提交真实密钥。
# 在终端运行 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成会话密钥。
SESSION_SECRET=replace-with-your-own-random-session-secret
# 本地不需要 Redis 就能用同一台服务进行多人联机测试。
# 填入真实 DeepSeek key 后，本地复杂局面可按需请求模型。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=1800
DEEPSEEK_RPM=30
DEEPSEEK_CONCURRENCY=3
DEEPSEEK_POLICY=balanced
DEEPSEEK_MAX_PER_HAND=4
# balanced: 每手首次可选决策及后续复杂局面；complex: 仅翻牌后复杂局面
# always: 每次操作均可尝试（仍受预算限制）；off: 关闭；日志设置为 0 可关闭
DEEPSEEK_LOG=1
# 部署 Vercel 时须配置 Redis 来存储共享房间和全局模型流量预算。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
