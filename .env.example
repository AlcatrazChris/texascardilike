# Vercel 中必须配置。用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
SESSION_SECRET=replace-with-at-least-32-random-characters

# 可选：默认不请求外部模型。密钥只配置到服务端，不要提交或放进前端。
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=1800
DEEPSEEK_RPM=30
DEEPSEEK_CONCURRENCY=3
DEEPSEEK_POLICY=balanced
DEEPSEEK_MAX_PER_HAND=4
DEEPSEEK_LOG=1
# 在 Vercel 上启用 DeepSeek 时，必须同时配置 Redis 的分布式限流。
# 缺少 Redis 或 Redis 不可用时自动使用本地 AI。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
